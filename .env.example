# Google Cloud Project Configuration
PROJECT_ID=your-project-id
LOCATION=us-central1

# Authentication (required for Vertex AI)
# Option 1: Place service-account-key.json in the project root (no env var needed).
# Option 2: Set SERVICE_ACCOUNT_KEY_PATH to your key file path (e.g. ../keys/my-key.json).
# Option 3: Set GOOGLE_APPLICATION_CREDENTIALS to the absolute path of your key file.
# SERVICE_ACCOUNT_KEY_PATH=       

# Database: use ONE of the following.
#
# Option A - PostgreSQL (recommended for Render / Railway)
#
# --- Only variable you need to change when swapping databases ---
# Paste the full connection string from Render → PostgreSQL → Connect.
#   • On your PC (npm start): use External Database URL + append ?sslmode=require
#   • On Render Web Service: use Internal Database URL (or link DB so Render sets DATABASE_URL)
#
# After each NEW free Postgres instance: run database/schema.pg.sql once in that database.
# If the users table is empty, the app creates superadmin@zaha.ai (password: admin123) on startup.
#
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
#
# Option B - MySQL (e.g. PlanetScale, or local)
# Leave DATABASE_URL unset and set these instead.
# DB_HOST=localhost
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_NAME=your_database

# Session secret (change in production)
SESSION_SECRET=your-random-secret-key

# ---------------------------------------------------------------------------
# Production hardening (Phase 1)
# ---------------------------------------------------------------------------
NODE_ENV=production
# Serve cookies only over HTTPS (set true behind Render/nginx SSL)
COOKIE_SECURE=true
# CORS allow-list: comma-separated storefront origins. Leave empty = permissive.
ALLOWED_ORIGINS=https://yourstore.com,https://www.yourstore.com
# Rate limits (requests per window)
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT=20
TRYON_RATE_LIMIT_PER_MIN=10
# Verify the database TLS certificate (recommended). Optionally supply a CA PEM.
DATABASE_SSL_STRICT=true
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Per-site domain enforcement for plugin API keys: off | report | strict
PLUGIN_DOMAIN_ENFORCEMENT=report

# ---------------------------------------------------------------------------
# 4K fidelity / enhancement pipeline (Phase 1)
# ---------------------------------------------------------------------------
# Master switch for enhancing try-on output to 4K (default: on)
UPSCALE_ENABLED=true
# External detail-generating super-resolution. Leave unset to use the built-in
# sharp/Lanczos 4K upscaler (always works, no API key needed).
# UPSCALE_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_xxx
# REPLICATE_UPSCALE_VERSION=  # optional: pin a specific model version

# ---------------------------------------------------------------------------
# Fidelity pipeline — Phase 2 (background lock-in + face restore)
# Both require REPLICATE_API_TOKEN and are OFF by default. When on, they get the
# result closer to "person unchanged, only the outfit differs".
# ---------------------------------------------------------------------------
# Segment the person out of the result and composite onto the ORIGINAL photo's
# background, so the real background is preserved pixel-for-pixel.
# BACKGROUND_LOCK_ENABLED=true
# REPLICATE_REMBG_VERSION=            # optional: pin the background-removal model

# Restore the face to counteract identity/expression drift from generation.
# FACE_RESTORE_ENABLED=true
# FACE_RESTORE_FIDELITY=0.9           # 0..1, higher = stay closer to the input face
# REPLICATE_FACE_RESTORE_VERSION=     # optional: pin the face-restore model

# ---------------------------------------------------------------------------
# Shopify App — Phase 3 (OAuth, webhooks, billing, app proxy)
# Routes at /shopify/* activate only when the first three are set.
# ---------------------------------------------------------------------------
# SHOPIFY_API_KEY=your-app-client-id
# SHOPIFY_API_SECRET=your-app-client-secret
# SHOPIFY_APP_URL=https://your-zaha-app.onrender.com
# SHOPIFY_SCOPES=read_products
# SHOPIFY_API_VERSION=2024-10
# Billing (optional): require a subscription after install
# SHOPIFY_BILLING_ENABLED=true
# SHOPIFY_PLAN_NAME=ZAHA Virtual Try-On
# SHOPIFY_PLAN_PRICE=19.00
# SHOPIFY_PLAN_TRIAL_DAYS=7
# SHOPIFY_BILLING_TEST=true           # use test charges during development

